# ---------------------------------------------------------------
# VISION MTF — Stripe Payment Links
# Create 3 Payment Links in your Stripe Dashboard and paste them here.
# Rename this file to .env.local
# ---------------------------------------------------------------
NEXT_PUBLIC_STRIPE_STARTER_URL=https://buy.stripe.com/your_starter_link
NEXT_PUBLIC_STRIPE_PRO_URL=https://buy.stripe.com/your_pro_link
NEXT_PUBLIC_STRIPE_FUNDED_URL=https://buy.stripe.com/your_funded_link

# Optional: private access / community links
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_channel
NEXT_PUBLIC_SITE_URL=https://visionmtf.com

# ---------------------------------------------------------------
# VISION MTF V5.0 — Vision AI Engine
# ---------------------------------------------------------------

# GPT-4o Vision — reads the five chart images. Unset = mock analysis.
OPENAI_API_KEY=sk-...
# Optional override (default: gpt-4o)
OPENAI_VISION_MODEL=gpt-4o

# Telegram delivery. Both required, or sends are skipped (not failed).
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHANNEL_ID=-1001234567890

# Protects /api/cron/analyze. Vercel Cron sends it as a Bearer token.
# Leave unset to keep the endpoint open for manual testing.
CRON_SECRET=

# MetaTrader 5 — used by scripts/mt5_factory.py only (Windows).
# Without these the factory renders mock charts.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
